+/**
+ * Green DevOps Config F′ only: point this worker at its own database.
+ *
+ * Runs before each test file. `process.env` is shared by every file a worker
+ * runs, so the base name is kept once and the suffix is never appended twice.
+ */
+const base = (process.env.F_PRIME_BASE_DATABASE_NAME ??=
+  process.env.DATABASE_NAME || "monize_test");
+process.env.DATABASE_NAME = `${base}_${process.env.JEST_WORKER_ID}`;
