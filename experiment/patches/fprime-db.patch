+++ b/backend/test/helpers/per-worker-db.global-setup.ts
@@ -0,0 +1,31 @@
+import { Client } from "pg";
+
+/**
+ * Green DevOps Config F′ only: one database per Jest worker.
+ *
+ * Creates `<DATABASE_NAME>_1 … _<maxWorkers>` before any worker starts, so each
+ * worker's `dropSchema` rebuild touches only its own database. The worker
+ * count is Jest's own (`globalConfig.maxWorkers`), never chosen by hand.
+ */
+export default async function globalSetup(globalConfig: {
+  maxWorkers: number;
+}): Promise<void> {
+  const base = process.env.DATABASE_NAME || "monize_test";
+  const client = new Client({
+    host: process.env.DATABASE_HOST || "localhost",
+    port: parseInt(process.env.DATABASE_PORT || "5432"),
+    user: process.env.DATABASE_USER || "monize_user",
+    password: process.env.DATABASE_PASSWORD || "monize_password",
+    database: "postgres",
+  });
+  await client.connect();
+  for (let i = 1; i <= globalConfig.maxWorkers; i++) {
+    const name = `${base}_${i}`;
+    const { rowCount } = await client.query(
+      "SELECT 1 FROM pg_database WHERE datname = $1",
+      [name],
+    );
+    if (!rowCount) await client.query(`CREATE DATABASE "${name}"`);
+  }
+  await client.end();
+}
